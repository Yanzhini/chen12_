 330          /******************主程序**********************/           
 331          void main()
 332          {               
 333   1              init_1602();    //lcd1602初始化
 334   1              while(1)
 335   1              {
 336   2                      flag_300ms ++;
 337   2                      if(flag_300ms >= 300)    //300毫秒执行一次里面的程序 
 338   2                      {
 339   3                              flag_300ms = 0;
 340   3                              dht11_dis();            //先读出温湿度的值
 341   3                              write_lcd2(2,3,table_dht11[0]);   //显示湿度    
 342   3                              write_lcd2(1,3,table_dht11[2]);    //显示温度
 343   3                              clock_h_l();   //报警函数
 344   3                      }
 345   2                      key();                                  //按键程序 
 346   2                      key_with();                         //设置报警温度      
 347   2                      if(menu_1 == 0)
 348   2                      {       
 349   3                              if(key_can == 3)
 350   3                              {
 351   4                                      flag_en = 0;   //手动取消报警
 352   4                                      beep = 1;      //关闭蜂鸣器
 353   4                              }
 354   3                      }
 355   2                      delay_1ms(1);
 356   2              }
 357   1      }
