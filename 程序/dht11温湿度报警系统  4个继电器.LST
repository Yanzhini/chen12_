 123          /***********************lcd1602初始化设置************************/
 124          void init_1602()        //lcd1602初始化
 125          {
 126   1              write_com(0x38);  //显示模式设置：16×2显示，5×7点阵，8位数据接口 不检测忙信号
 127   1              write_com(0x0c);  //开显示 不显示光标
 128   1              write_com(0x06);  //当写一个字符是，地址指针加 1
 129   1              write_string(1,0,"Wd:00  H00  L00  ");  //初始化1602显示 
 130   1              write_string(2,0,"Sd:00% H00% L00% ");  //初始化1602显示 
 131   1              write_zifu(1,5,0xdf);   //显示温度单位度                
 132   1              write_zifu(1,10,0xdf);  //显示温度单位度                
 133   1              write_zifu(1,15,0xdf);  //显示温度单位度                
 134   1              write_lcd2(1,3,table_dht11[2]);    //显示温度
 135   1              write_lcd2(2,3,table_dht11[0]);   //显示湿度    
 136   1              write_lcd2(1,8,t_high);   //显示温度上限
 137   1              write_lcd2(2,8,s_high);   //显示湿度上限                
 138   1              write_lcd2(1,13,t_low);   //显示温度下限
 139   1              write_lcd2(2,13,s_low);   //显示湿度下限        
 140   1      }
