  29          /***************************************************************
  30          * 名称 : delay_1ms()
  31          * 功能 : 延时1ms函数
  32          * 输入 : q
  33          * 输出 : 无
  34          ****************************************************************/
  35          void delay_1ms(uint q)
  36          {
  37   1              uint i,j;
  38   1              for(i=0;i<q;i++)
  39   1                      for(j=0;j<120;j++);
  40   1      }
  41          
  42          /********************************************************************
  43          * 名称 : delay_uint()
  44          * 功能 : 小延时。
  45          * 输入 : 无
  46          * 输出 : 无
  47          ***********************************************************************/
  48          void delay_uint(uint q)
  49          {
  50   1              while(q--);
  51   1      }
