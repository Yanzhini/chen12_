 249          /*****************读温湿度传感器程序****************/
 250          void dht11_dis()
 251          {
 252   1              uchar i,j;                       
 253   1              dht11 = 0;         //DHT11端口复位，发出起始信号 
 254   1              delay_1ms(18);
 255   1              dht11 = 1;
 256   1              delay_uint(4);    
 257   1              if(dht11 == 0)    //判断是否响应    
 258   1              {
 259   2                      while(dht11 == 0);        //等待低电平时间过完
 260   2                      while(dht11 == 1);        //等待高电平时间过完
 261   2                      for(i=0;i<5;i++)
 262   2                      {
 263   3                              for(j=0;j<8;j++)
 264   3                              {
 265   4                                      table_dht11[i] <<= 1;  //数据左移一位低位自动补0
 266   4                                      while(dht11 == 0);  //等待低电平时间过完
 267   4                                      delay_uint(3);      //数据1的高电平时间 
 268   4                                      if(dht11 == 1)
 269   4                                      {
 270   5                                              table_dht11[i] |= 0x01;
 271   5                                              while(dht11 == 1);        //等待高电平时间过完
 272   5                                      }                       
 273   4                              }                       
 274   3                      }                       
 275   2              }
 276   1              dht11 = 1;       //释放总线 
 277   1      }
 278           
 279          /****************报警函数***************/
 280          void clock_h_l()
 281          {
 282   1              if((table_dht11[2] >= t_high))      //温度大于等于上限
 283   1              {                        
 284   2                      relay1 = 0;               //打开继电器
 285   2              }
 286   1              else 
 287   1              {
 288   2                      relay1 = 1;               //关闭继电器
 289   2              }
 290   1      
 291   1              if((table_dht11[2] <= t_low))      //温度小于等于下限
 292   1              {                        
 293   2                      relay2 = 0;               //打开继电器
 294   2              }
 295   1              else 
 296   1              {
 297   2                      relay2 = 1;               //关闭继电器
 298   2              }
 299   1      
 300   1              if((table_dht11[0] >= s_high))     //湿度大于等于上限
 301   1              {
 302   2                      relay3 = 0;               //打开继电器
C51 COMPILER V9.01   DHT11蝊湿度报綺系统__4个继电器                                        12/07/2024 12:41:16 PAGE 6   

 303   2              }else 
 304   1              {
 305   2                      relay3 = 1;               //关闭继电器
 306   2              }
 307   1      
 308   1              if((table_dht11[0] <= s_low))     //湿度小于等于下限
 309   1              {
 310   2                      relay4 = 0;               //打开继电器
 311   2              }else 
 312   1              {       
 313   2                      relay4 = 1;               //关闭继电器
 314   2              }
 315   1      
 316   1              if((relay1 == 0) || (relay2 == 0) || (relay3 == 0) || (relay4 == 0))
 317   1              {
 318   2                      if(flag_en == 1)
 319   2                              beep = ~beep;     //蜂鸣器报警
 320   2              }
 321   1              else 
 322   1              {
 323   2                      beep = 1;
 324   2                      flag_en = 1;
 325   2              }
 326   1              
 327   1      }
