  87          /***********************lcd1602上显示特定的字符****0XDF 度********************/
  88          void write_zifu(uchar hang,uchar add,uchar date)
  89          {
  90   1              if(hang==1)   
  91   1                      write_com(0x80+add);       //写1602第一行的地址 
  92   1              else
  93   1                      write_com(0x80+0x40+add);  //写1602第二行的地址 
  94   1              write_data(date);                 //写数据 
  95   1      }
  96          
  97          /***********************lcd1602上显示两位十进制数************************/
  98          void write_lcd2(uchar hang,uchar add,uint date)
  99          {
 100   1              if(hang==1)   
 101   1                      write_com(0x80+add);       //写1602第一行的地址 
 102   1              else
 103   1                      write_com(0x80+0x40+add);  //写1602第二行的地址 
 104   1              write_data(0x30+date/10%10);    //显示十位数
 105   1              write_data(0x30+date%10);       //显示个位数
 106   1      }
