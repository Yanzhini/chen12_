 153   2                      if(key2 == 0)           //确认是按键按下
 154   2                              key_can = 2;    //得到按键值 
 155   2                      if(key3 == 0)           //确认是按键按下
 156   2                              key_can = 3;    //得到按键值 
 157   2                      beep = 0;                       //蜂鸣器叫一声
 158   2                      delay_1ms(50);
 159   2                      beep = 1;
 160   2              }
 161   1      }
